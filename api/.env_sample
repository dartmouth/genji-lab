SQLALCHEMY_DATABASE_URL=""
DB_SCHEMA=app
SESSION_SECRET_KEY=''

# OIDC (Microsoft Entra ID) authentication.
# OIDC_REDIRECT_URI must exactly match a redirect URI registered on the Entra
# app registration (scheme/host/port/path), e.g.
# http://localhost:5173/api/v1/oauth2/callback in dev.
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=
OIDC_REDIRECT_URI=http://localhost:5173/api/v1/oauth2/callback
OIDC_SCOPES=openid profile email
OIDC_POST_LOGIN_REDIRECT=/
OIDC_POST_ERROR_REDIRECT=/login
OIDC_BUTTON_LABEL=Sign in with Dartmouth